{%- comment -%}
  App embed: loads Cartivo (cart drawer, sticky add-to-cart, floating cart) on every page.
  Settings and campaigns are managed in the Cartivo app and stored in an app-data metafield.
{%- endcomment -%}
{%- assign ck_config = app.metafields.cartkit.config.value -%}
{%- if ck_config -%}
  {{ 'cartkit.css' | asset_url | stylesheet_tag }}
  <script id="cartkit-config" type="application/json">{{ ck_config | json }}</script>
  <script id="cartkit-context" type="application/json">
    {
      "moneyFormat": {{ shop.money_format | json }},
      "locale": {{ request.locale.iso_code | json }},
      "country": {{ localization.country.iso_code | json }},
      "language": {{ localization.language.iso_code | json }},
      "rootUrl": {{ routes.root_url | json }},
      "template": {{ template.name | json }},
      "designMode": {{ request.design_mode | json }},
      "previewDrawer": {{ block.settings.preview_drawer | json }},
      "cart": {{ cart | json }},
      {%- comment -%}
        Only the fields the sticky add-to-cart reads (not the full product JSON with its description),
        so product pages carry less inline data.
      {%- endcomment -%}
      "product": {% if template.name == 'product' and product -%}
        {
          "title": {{ product.title | json }},
          "has_only_default_variant": {{ product.has_only_default_variant | json }},
          "featured_image": {% if product.featured_image %}{{ product.featured_image | image_url: width: 400 | json }}{% else %}null{% endif %},
          "variants": [
            {%- for v in product.variants -%}
              {
                "id": {{ v.id | json }},
                "title": {{ v.title | json }},
                "available": {{ v.available | json }},
                "price": {{ v.price | json }},
                "compare_at_price": {{ v.compare_at_price | json }},
                "featured_image": {% if v.featured_image %}{ "src": {{ v.featured_image | image_url: width: 400 | json }} }{% else %}null{% endif %}
              }{% unless forloop.last %},{% endunless %}
            {%- endfor -%}
          ]
        }
      {%- else -%}null{%- endif %}
    }
  </script>
  <script src="{{ 'cartkit.js' | asset_url }}" defer></script>
{%- endif -%}

{% schema %}
{
  "name": "t:embed.name",
  "target": "body",
  "settings": [
    {
      "type": "paragraph",
      "content": "Colors, texts, campaigns and the sticky add-to-cart are set up in the SC Cartivo app."
    },
    {
      "type": "checkbox",
      "id": "preview_drawer",
      "label": "Preview the cart drawer in the theme editor",
      "info": "Opens the drawer while you edit your theme. Shoppers never see this.",
      "default": false
    }
  ]
}
{% endschema %}
