# Copy to .env (optional). `shopify app dev` provides SHOPIFY_API_KEY / SECRET / SCOPES / APP_URL automatically.

# Postgres connection strings (Neon: Dashboard → Connect → Prisma). DIRECT_URL = same without "-pooler", used for migrations
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Unlock all Pro features without a subscription (handy while developing)
BILLING_DISABLED=true

# Force test charges in production (e.g. on development stores)
# BILLING_TEST=true
# Support (optional): shown in the Help panel / notified on new requests (Slack- or Discord-compatible webhook)
SUPPORT_EMAIL=
SUPPORT_DOCS_URL=
SUPPORT_WEBHOOK_URL=
# Live chat inbox at <app url>/support/inbox (disabled when empty). Use a long random string.
SUPPORT_INBOX_KEY=
