# Copy to .env (optional). `shopify app dev` provides SHOPIFY_API_KEY / SECRET / SCOPES / APP_URL automatically.

# Postgres connection strings (Neon: Dashboard → Connect → Prisma). DIRECT_URL = same without "-pooler", used for migrations
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Unlock all Pro features without a subscription (handy while developing). Ignored when NODE_ENV=production.
BILLING_DISABLED=true

# Run the app as one plan while developing, without a Shopify charge: free, basic (Essential), grow (Growth)
# or pro (Premium). Ignored when NODE_ENV=production.
# DEV_PLAN=basic

# Test charges are automatic: always in development, and in production only on Shopify development stores.
# Show the manual "Shop domain" login form on a non-production deployment (never needed in production).
# ALLOW_MANUAL_LOGIN=true

# Support (optional): shown in the Help panel / notified on new requests (Slack- or Discord-compatible webhook)
SUPPORT_EMAIL=
SUPPORT_DOCS_URL=
SUPPORT_WEBHOOK_URL=
# Live chat inbox at <app url>/support/inbox (disabled when empty). Use a long random string.
SUPPORT_INBOX_KEY=
